# web/.env —— 网页版短语云同步配置
# 复制本文件为 web/.env 并填写实际值；web/.env 已被 .gitignore 忽略，不会提交到仓库
# 部署到 Vercel 时，把下面各项原样（明文）配置到项目的环境变量即可，键名完全一致

# ===== 访问码 =====
# 方式一（推荐，最简单）：直接填明文访问码
ACCESS_CODE=
# 方式二：填访问码的 SHA-256 十六进制值（小写），不想在配置里放明文密码时用
# 生成命令：
#   Linux/macOS: echo -n "你的访问码" | sha256sum
#   PowerShell:  -join (([System.Security.Cryptography.SHA256]::Create()).ComputeHash([Text.Encoding]::UTF8.GetBytes("你的访问码")) | ForEach-Object { $_.ToString("x2") })
ACCESS_CODE_HASH=
# 两者都填时以 ACCESS_CODE 为准；都留空则任意访问码均可解锁

# ===== 同步目标 =====
# 参与同步的目标，多个用逗号分隔：s3,github（页面中可单选/多选）
SYNC_TARGETS=s3,github
# 点击「加载短语」时默认使用的源：s3 或 github（页面中可切换）
DEFAULT_SOURCE=s3

# ===== 短语文件格式 =====
# sg=搜狗 bd=百度 csv=CSV rime=Rime dd=多多（云端加载按此格式解析，上传默认此格式）
PHRASE_FORMAT=sg

# ===== S3 =====
S3_ENDPOINT_URL=https://s3.bitiful.net
S3_REGION=cn-east-1
S3_BUCKET=your-bucket
# 上传路径（目录，以 / 结尾）
S3_PATH=t/
# 公开读的基础 URL（用于「加载」和页脚下载链接；留空则改用签名 GET 请求）
S3_PUBLIC_URL=https://your-bucket.s3.bitiful.net
# S3 凭证（明文）
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# 各格式上传时的文件名（可选）。默认跟随格式自动取名：
#   sg=PhraseEdit.txt  bd=百度.ini.txt  csv=自定义短语.csv
#   rime=Rime自定义短语.txt  dd=多多自定义短语.txt  dat=微软.dat  lex=微软.lex
# 需要改某个格式的文件名时再配置对应键，例如：
# S3_FILENAME_SG=PhraseEdit.txt
# S3_FILENAME_BD=百度.ini.txt

# ===== GitHub =====
GITHUB_REPO=songshua295/MSPhraseTool
GITHUB_BRANCH=main
# 存放路径（目录，以 / 结尾）
GITHUB_PATH=web/data/
# 各格式上传文件名（可选，默认跟随格式自动取名，同 S3_FILENAME_*；需要时配置 GITHUB_FILENAME_SG 等）
# 需要 repo contents 写权限的 Personal Access Token（明文；不使用 GitHub 同步可留空）
GITHUB_TOKEN=
